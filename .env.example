# ============================================
# AI内容分析工具 - 后台配置文件
# ============================================

# 服务器端口（默认3000，部署时由平台自动分配）
PORT=3000

# ============================================
# AI服务商配置
# ============================================
# 可选值: qianwen | wenxin | doubao | openai
AI_PROVIDER=qianwen

# ============================================
# API密钥配置
# ============================================
# 根据选择的AI服务商，配置对应的API密钥

# 阿里云 通义千问 API Key
# 获取地址: https://dashscope.aliyuncs.com/
AI_API_KEY=your-qianwen-api-key

# 百度 文心一言 API Secret（仅文心一言需要）
# 获取地址: https://console.bce.baidu.com/ai/
AI_API_SECRET=your-wenxin-api-secret

# ============================================
# 配置说明
# ============================================
# 1. 将此文件复制为 .env
# 2. 根据选择的AI服务商填写对应的API密钥
# 3. 部署时可通过环境变量覆盖这些配置

# 阿里云 通义千问:
#   AI_PROVIDER=qianwen
#   AI_API_KEY=你的通义千问API密钥

# 百度 文心一言:
#   AI_PROVIDER=wenxin
#   AI_API_KEY=你的文心一言API Key
#   AI_API_SECRET=你的文心一言API Secret

# 字节跳动 豆包:
#   AI_PROVIDER=doubao
#   AI_API_KEY=你的豆包API密钥

# OpenAI GPT:
#   AI_PROVIDER=openai
#   AI_API_KEY=你的OpenAI API密钥