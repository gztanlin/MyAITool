{
  "version": "v2",
  "services": [
    {
      "name": "ai-content-analyzer",
      "resource": {
        "instance_type": "ecs.g6.large",
        "instance_num": 1
      },
      "runtime": {
        "language": "custom-container",
        "work_dir": "/app",
        "command": "npm start"
      },
      "code": {
        "path": ".",
        "excludes": ["node_modules", ".git", ".env"]
      },
      "build": {
        "command": "docker build -t ai-content-analyzer .",
        "build_dir": ".",
        "dockerfile_path": "Dockerfile"
      },
      "network": {
        "internet_access": true
      },
      "env_vars": {
        "AI_PROVIDER": "qianwen",
        "PORT": "3000"
      }
    }
  ]
}
